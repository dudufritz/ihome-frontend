# ═══════════════════════════════════════════════════════════════════
#  Caddy — HTTPS, frontend e API sob o MESMO domínio
#
#  Por que uma origem só: com o frontend em um domínio e a API em outro,
#  toda requisição precisaria passar pela negociação de CORS, e um erro
#  de configuração ali só aparece no console do navegador do usuário.
#  Servindo os dois de https://seu-dominio, o navegador considera tudo
#  a mesma origem e o problema deixa de existir.
#
#  O HTTPS é automático: o Caddy obtém o certificado do Let's Encrypt na
#  primeira subida e o renova sozinho antes de vencer. Não há cron nem
#  certbot para manter — e o PWA só é instalável sob HTTPS.
# ═══════════════════════════════════════════════════════════════════

{$DOMINIO} {

	# ── Cabeçalhos de segurança ──
	# O helmet já os aplica nas respostas da API; aqui eles valem também
	# para os arquivos estáticos do frontend.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "strict-origin-when-cross-origin"
		Permissions-Policy        "geolocation=(), microphone=(), camera=()"
		# Revela menos sobre a stack para quem varre a internet.
		-Server
	}

	# ── API ──
	# Tudo sob /api vai para o backend. O strip_prefix remove o /api antes
	# de repassar, então o Express continua enxergando /auth/login e não
	# /api/auth/login — nenhuma rota precisou mudar.
	handle_path /api/* {
		reverse_proxy api:3001 {
			# Repassa o IP real do visitante. Sem isto, o rate limiting
			# contaria todo mundo como sendo o próprio Caddy.
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	# ── Frontend ──
	handle {
		root * /srv
		encode gzip zstd

		# Service Worker sempre revalidado: sem isto o navegador serve a
		# versão antiga do app indefinidamente depois de um deploy.
		@sw path /service-worker.js
		header @sw Cache-Control "no-cache, no-store, must-revalidate"

		# Os arquivos de /static levam hash no nome, então podem ser
		# guardados por um ano com segurança.
		@estaticos path /static/*
		header @estaticos Cache-Control "public, max-age=31536000, immutable"

		# SPA: qualquer caminho que não seja arquivo real devolve o
		# index.html, para o roteamento do React funcionar ao recarregar.
		try_files {path} /index.html
		file_server
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}
